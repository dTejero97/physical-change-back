# Copia este fichero a .env (o exporta las variables). Nunca subas .env al repositorio.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/physicalchange
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
ADMIN_USER=admin
ADMIN_PASSWORD=admin
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Archivos (ADR-001 / ADR-005). database = en PostgreSQL (por defecto). r2 = Cloudflare R2.
# Para activar R2: rellena las 4 variables R2_* y cambia STORAGE_TYPE a r2. Guía: MANUAL-DESPLIEGUE.md, Parte 8.
STORAGE_TYPE=database
STORAGE_QUOTA_MB=
# Tope de toda la plataforma (vacío = 9216 MB con r2, para no pasar de los 10 GB gratuitos)
STORAGE_GLOBAL_MAX_MB=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Solo si el bucket está en una jurisdicción (p. ej. UE): https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
